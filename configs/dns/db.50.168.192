$TTL 86400
@   IN SOA dns01.lab.corp.example. admin.lab.corp.example. (
        2026072201 ; serial
        604800     ; refresh
        86400      ; retry
        2419200    ; expire
        604800 )   ; minimum

    IN NS dns01.lab.example.internal.

5   IN PTR gateway.lab.corp.example.
10  IN PTR dns01.lab.corp.example.
15  IN PTR client1.lab.corp.example.
16  IN PTR client2.lab.corp.example.
17  IN PTR client3.lab.corp.example.

